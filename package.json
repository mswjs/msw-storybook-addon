{
  "type": "module",
  "name": "msw-storybook-addon",
  "version": "0.0.0",
  "description": "Mock APIs in Storybook using Mock Service Worker.",
  "exports": {
    ".": "./build/index.mjs",
    "./preview": "./build/preview.mjs",
    "./types": "./build/types.d.mts",
    "./csf3": "./build/csf3.mjs"
  },
  "bin": {
    "msw-storybook-migrate": "./build/migrate.mjs"
  },
  "storybook": {
    "displayName": "Mock Service Worker",
    "icon": "https://mswjs.io/msw-storybook-addon.png"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "lint": "publint",
    "install:browsers": "pnpm exec playwright install chromium --with-deps",
    "storybook": "storybook dev --config-dir ./tests/factory/.storybook",
    "storybook:csf3": "storybook dev --config-dir ./tests/csf3/.storybook",
    "storybook:factory-custom-setup": "storybook dev --config-dir ./tests/factory-custom-setup/.storybook",
    "test:stories": "playwright test",
    "test:play": "vitest -c ./tests/factory/vitest.config.ts --project storybook",
    "test:ts": "vitest --typecheck",
    "test:codemod": "vitest run -c ./codemod/vitest.config.ts",
    "build": "tsdown",
    "release": "release publish"
  },
  "files": [
    "./build"
  ],
  "keywords": [
    "storybook-addon",
    "api",
    "mock",
    "http",
    "graphql",
    "websocket",
    "sse",
    "network",
    "request",
    "intercept"
  ],
  "author": "Artem Zakharchenko <kettanaito@gmail.com>",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/mswjs/storybook"
  },
  "bugs": "https://github.com/mswjs/storybook/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ossjs/release": "^0.11.0",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-vitest": "^10.3.4",
    "@storybook/react-vite": "^10.3.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@vitest/browser-playwright": "4.1.9",
    "@vitest/coverage-v8": "4.1.9",
    "msw": "^2.14.6",
    "msw-storybook-addon": "link:.",
    "publint": "^0.3.21",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ts-dedent": "^2.3.0",
    "storybook": "^10.3.4",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "msw": ">=2",
    "storybook": ">=9"
  },
  "msw": {
    "workerDirectory": [
      "tests/public"
    ]
  }
}
