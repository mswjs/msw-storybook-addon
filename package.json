{
  "type": "module",
  "name": "msw-storybook-addon",
  "version": "3.0.3",
  "description": "Mock APIs in Storybook using Mock Service Worker.",
  "exports": {
    ".": "./build/index.mjs",
    "./preview": "./build/preview.mjs",
    "./types": "./build/types.d.mts",
    "./csf3": "./build/csf3.mjs"
  },
  "bin": {
    "msw-storybook-addon": "./build/migrate.mjs"
  },
  "storybook": {
    "displayName": "Mock Service Worker",
    "icon": "https://mswjs.io/msw-storybook-addon.png"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "lint": "publint",
    "install:browsers": "pnpm exec playwright install chromium --with-deps",
    "storybook": "storybook dev --config-dir ./tests/factory/.storybook",
    "storybook:csf3": "storybook dev --config-dir ./tests/csf3/.storybook",
    "storybook:factory-custom-setup": "storybook dev --config-dir ./tests/factory-custom-setup/.storybook",
    "storybook:msw-vite-plugin": "storybook dev --config-dir ./tests/msw-vite-plugin/.storybook",
    "test": "pnpm test:stories && pnpm test:play && pnpm test:ts",
    "test:stories": "playwright test",
    "test:play": "vitest -c ./tests/factory/vitest.config.ts --project storybook",
    "test:ts": "vitest --typecheck",
    "test:codemod": "vitest run -c ./codemod/vitest.config.ts",
    "build": "tsdown",
    "release": "release publish"
  },
  "files": [
    "./build"
  ],
  "keywords": [
    "storybook-addon",
    "api",
    "mock",
    "http",
    "graphql",
    "websocket",
    "sse",
    "network",
    "request",
    "intercept"
  ],
  "author": "Artem Zakharchenko <kettanaito@gmail.com>",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/mswjs/msw-storybook-addon"
  },
  "bugs": "https://github.com/mswjs/msw-storybook-addon/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@ossjs/release": "^0.11.2",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-vitest": "11.0.0-alpha.0",
    "@storybook/react-vite": "11.0.0-alpha.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.17",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "msw": "https://pkg.pr.new/msw@13144a2",
    "msw-storybook-addon": "link:.",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "11.0.0-alpha.0",
    "ts-dedent": "^2.3.0",
    "tsdown": "^0.22.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "msw": ">=3",
    "storybook": "^9.0.0 || ^10.0.0 || ^11.0.0-0"
  },
  "packageManager": "pnpm@11.5.2"
}
